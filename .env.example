# BlueBubbles server (required)
BB_SERVER_URL=http://127.0.0.1:1234
BB_PASSWORD=your-server-password

# Webhook listener on this machine (optional)
WEBHOOK_PORT=8787
# Bind address: 127.0.0.1 = localhost only, 0.0.0.0 = all interfaces (needed if BlueBubbles is on another machine).
# WARNING: 0.0.0.0 exposes the webhook to your entire network. Set WEBHOOK_PWD if you do this.
WEBHOOK_HOST=127.0.0.1
# URL the Mac uses to reach this machine. Leave empty to auto-detect the LAN IPv4.
WEBHOOK_PUBLIC_URL=
# Password appended as ?pwd= to the webhook URL. Empty = no auth.
WEBHOOK_PWD=

# Comma-separated sender addresses allowed to talk to Claude (phone numbers/emails).
# Empty = accept ALL senders (a loud warning is logged). Strongly recommended to set.
ALLOWED_SENDERS=+1234567890,you@example.com

# Where inbound attachments are saved (optional)
ATTACHMENTS_DIR=./attachments
